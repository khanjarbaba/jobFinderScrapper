# Copy this file to .env for local runs. In GitHub Actions, set the same
# names as repository secrets instead (Settings -> Secrets and variables -> Actions).

# Required for matching/ and salary_enrichment/ (Claude API)
ANTHROPIC_API_KEY=

# Optional Tier 1 sources (leave blank + set enabled: false in config.yaml to skip)
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: live FX rate lookup for salary conversion to INR.
# If blank, the pipeline falls back to config.yaml -> salary.fallback_fx_to_inr
EXCHANGE_RATE_API_KEY=

# Optional Tier 2/3 sources, only needed once those modules are implemented
NAUKRI_APIFY_TOKEN=
WELLFOUND_SESSION_COOKIE=
